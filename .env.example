# Local UI development is backend-independent by default.
VITE_DATA_PROVIDER="mock"

# Set VITE_DATA_PROVIDER="firebase" to use these public Web App identifiers.
# Never place Admin SDK credentials in a VITE_ variable.
VITE_FIREBASE_API_KEY="your-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-web-app-id"

# Optional: set this only when the app uses a named Firestore database.
VITE_FIREBASE_DATABASE_ID=""

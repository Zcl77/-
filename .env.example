#运行环境配置文件
# Copy to .env for local development. Replace every change-me value locally.
COMPOSE_PROJECT_NAME=zhixing-studio
#Docker项目名称，用来区分容器和数据卷

MYSQL_DATABASE=zhixing_studio
#MySQL数据库名称
MYSQL_USER=zhixing_app
#网站链接数据库使用的用户名
MYSQL_PASSWORD=change-me-local-database-password
#MySQL数据库密码
MYSQL_ROOT_PASSWORD=change-me-local-root-password
#MySQL root用户密码
MYSQL_HOST_PORT=3307
#MySQL数据库端口，在本机使用的端口，通常是3307
BACKEND_HOST_PORT=8000
#后端服务端口
FRONTEND_HOST_PORT=3000
#前端服务端口

DJANGO_SECRET_KEY=change-me-local-django-secret
#Django秘密密钥，Django使用的密钥，用于加密和解密数据，高敏感度，核心密钥
DJANGO_ENVIRONMENT=development
#Django环境配置
DJANGO_ENABLE_MOCK_PAYMENTS=false
#是否启用模拟支付
DJANGO_DEBUG=true
#Django调试模式，是否开启开发调试模式
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
#允许的主机地址，允许访问后端的域名或主机
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#CSRF信任的源，Django 信任的网页来源，防止跨站请求攻击
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#CORS允许的源
FRONTEND_SITE_URL=http://127.0.0.1:3000/
#前端站点URL
DJANGO_SESSION_COOKIE_SECURE=false
#会话Cookie是否安全，登录 Cookie 是否只允许通过 HTTPS 传输
DJANGO_CSRF_COOKIE_SECURE=false
#CSRF Cookie是否安全，CSRF Cookie 是否只允许通过 HTTPS 传输
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_USE_X_ACCEL_REDIRECT=false
#是否让 Nginx 代替 Django 安全传输媒体文件

VITE_API_BASE_URL=/api/v1
#前端Vite的API基础URL，前端请求后端API的基础路径

#.env数据分布
#.env
#├─ 数据库密码
#├─ Django 安全密钥
#├─ 本机端口
#└─ 网站运行及安全开关

#MySQL Docker Volume
#├─ 用户账号
#├─ 作品文字信息
#├─ 询价和订单
#├─ 客户项目
#└─ 制作进度

#媒体 Docker Volume
#├─ 作品图片
#└─ 客户进度图片

#
#同一套代码
#├─ 本地电脑 + 本地 .env
#├─ 别人的电脑 + 对方电脑自己的 .env
#└─ 正式服务器 + 生产环境配置


#这些是这台电脑的本地开发环境配置文件，包含了数据库密码、Django安全密钥、本机端口以及网站运行和安全开关等信息。
#DJANGO_DEBUG=true
#DJANGO_SESSION_COOKIE_SECURE=false
#DJANGO_CSRF_COOKIE_SECURE=false


#在他人电脑中运行，也需要在项目根目录创建：
# .env文件，内容和本地电脑的.env文件类似，但需要替换为对方电脑自己的数据库密码、Django安全密钥、本机端口以及网站运行和安全开关等信息。
#项目目录\.env
#Copy-Item .env.example .env
#notepad .env
#然后生成新的数据库密码和 Django 密钥。
#如果需要恢复你当前电脑的完整数据，就要使用便携包，并提供与备份匹配的 .env。恢复成功后，可以再有计划地轮换密码。
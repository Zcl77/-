{
  "name": "zhixing-studio-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0 --port 3000",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run tests/validation.test.ts tests/migration-visibility.test.mjs --configLoader runner",
    "test:rules": "firebase emulators:exec --project demo-zhixing-studio --only firestore,storage \"vitest run tests/rules --configLoader runner\"",
    "check": "npm run typecheck && npm test && npm run build",
    "admin:claim": "node scripts/set-admin-claim.mjs",
    "migrate:data": "node scripts/migrate-firebase-data.mjs"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}

{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "scale": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["WIP", "Completed", "Sold"] },
        "description": { "type": "string" },
        "timeSpent": { "type": "number" },
        "createdAt": { "type": "string" },
        "completionPercent": { "type": "number" },
        "coverUrl": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "worksteps": { "type": "array" },
        "dimensions": { "type": "string" },
        "materials": { "type": "string" },
        "period": { "type": "string" },
        "inspiration": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "rooms": { "type": "array" }
      },
      "required": ["title", "category", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "A review or commission.",
      "type": "object",
      "properties": {
        "reviewerName": { "type": "string" },
        "rating": { "type": "number" },
        "projectName": { "type": "string" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["reviewerName", "rating", "projectName", "comment", "createdAt"]
    },
    "CategoriesDoc": {
      "title": "Categories",
      "description": "List of categories",
      "type": "object",
      "properties": {
        "list": { "type": "array", "items": { "type": "string" } }
      }
    },
    "HiddenCategoriesDoc": {
      "title": "Hidden Categories",
      "description": "List of hidden categories",
      "type": "object",
      "properties": {
        "list": { "type": "array", "items": { "type": "string" } }
      }
    },
    "CraftsmenDoc": {
      "title": "Craftsmen Profiles",
      "description": "Profiles for craftsmen",
      "type": "object",
      "properties": {
        "profiles": { "type": "object" }
      }
    },
    "SettingsDoc": {
      "title": "Global Settings",
      "description": "Global settings",
      "type": "object",
      "properties": {
        "wechatId": { "type": "string" },
        "wechatQrUrl": { "type": "string" }
      }
    },
    "PresetsDoc": {
      "title": "Preset Images",
      "description": "Preset images",
      "type": "object",
      "properties": {
        "images": { "type": "array" }
      }
    }
  },
  "firestore": {
    "projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Stores all projects"
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Stores all reviews"
    },
    "metadata/categories": {
      "schema": { "$ref": "#/entities/CategoriesDoc" },
      "description": "Stores category list"
    },
    "metadata/hiddenCategories": {
      "schema": { "$ref": "#/entities/HiddenCategoriesDoc" },
      "description": "Stores hidden categories"
    },
    "metadata/craftsmen": {
      "schema": { "$ref": "#/entities/CraftsmenDoc" },
      "description": "Stores craftsmen profiles"
    },
    "metadata/settings": {
      "schema": { "$ref": "#/entities/SettingsDoc" },
      "description": "Stores studio settings"
    },
    "metadata/presetImages": {
      "schema": { "$ref": "#/entities/PresetsDoc" },
      "description": "Stores preset images"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasProjectFields(data) {
      return data.keys().hasAll([
          'title', 'scale', 'category', 'status', 'visibility', 'description',
          'timeSpent', 'createdAt', 'completionPercent', 'coverUrl', 'images', 'worksteps'
        ])
        && data.keys().hasOnly([
          'title', 'scale', 'category', 'status', 'visibility', 'description',
          'timeSpent', 'createdAt', 'completionPercent', 'coverUrl', 'images', 'worksteps',
          'dimensions', 'materials', 'period', 'inspiration', 'authors', 'rooms',
          'imageAssets', 'isDemo'
        ]);
    }

    function isValidProject(data) {
      return hasProjectFields(data)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.scale is string && data.scale.size() <= 40
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.status in ['WIP', 'Completed', 'Sold']
        && data.visibility in ['public', 'hidden']
        && data.description is string && data.description.size() > 0 && data.description.size() <= 5000
        && data.timeSpent is number && data.timeSpent >= 0
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.completionPercent is number && data.completionPercent >= 0 && data.completionPercent <= 100
        && data.coverUrl is string
        && data.images is list && data.images.size() <= 100
        && data.worksteps is list && data.worksteps.size() <= 100
        && (!('authors' in data) || (data.authors is list && data.authors.size() <= 50))
        && (!('rooms' in data) || (data.rooms is list && data.rooms.size() <= 100))
        && (!('imageAssets' in data) || (data.imageAssets is list && data.imageAssets.size() <= 300))
        && (!('isDemo' in data) || data.isDemo is bool);
    }

    match /projects/{projectId} {
      allow get, list: if isAdmin() || resource.data.visibility == 'public';
      allow create, update: if isAdmin() && isValidId(projectId) && isValidProject(request.resource.data);
      allow delete: if isAdmin() && isValidId(projectId);
    }

    function hasReviewFields(data) {
      return data.keys().hasAll(['reviewerName', 'rating', 'projectName', 'comment', 'createdAt', 'status'])
        && data.keys().hasOnly([
          'reviewerName', 'rating', 'projectName', 'comment', 'createdAt', 'status',
          'moderatedAt', 'moderatedBy', 'isDemo'
        ]);
    }

    function isValidReview(data) {
      return hasReviewFields(data)
        && data.reviewerName is string && data.reviewerName.size() > 0 && data.reviewerName.size() <= 50
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.projectName is string && data.projectName.size() > 0 && data.projectName.size() <= 120
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.status in ['pending', 'approved', 'rejected']
        && (!('moderatedAt' in data) || (data.moderatedAt is string && data.moderatedAt.size() <= 50))
        && (!('moderatedBy' in data) || (data.moderatedBy is string && data.moderatedBy.size() <= 128))
        && (!('isDemo' in data) || data.isDemo is bool);
    }

    function isValidPublicReviewSubmission(data) {
      return data.keys().hasAll(['reviewerName', 'rating', 'projectName', 'comment', 'createdAt', 'status'])
        && data.keys().hasOnly(['reviewerName', 'rating', 'projectName', 'comment', 'createdAt', 'status'])
        && isValidReview(data)
        && data.status == 'pending';
    }

    match /reviews/{reviewId} {
      allow get, list: if isAdmin() || resource.data.status == 'approved';
      allow create: if isValidId(reviewId) && isValidPublicReviewSubmission(request.resource.data);
      allow update: if isAdmin()
        && isValidId(reviewId)
        && isValidReview(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'moderatedAt', 'moderatedBy']);
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    match /metadata/categories {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 100;
    }

    match /metadata/hiddenCategories {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 100;
    }

    match /metadata/settings {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['wechatId', 'wechatQrUrl'])
        && request.resource.data.keys().hasOnly(['wechatId', 'wechatQrUrl', 'wechatQrAsset'])
        && request.resource.data.wechatId is string
        && request.resource.data.wechatId.size() <= 100
        && request.resource.data.wechatQrUrl is string;
    }

    match /metadata/craftsmen {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['profiles'])
        && request.resource.data.profiles is map
        && request.resource.data.profiles.size() <= 100;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

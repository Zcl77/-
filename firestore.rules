rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Allowing any authenticated user to act as admin for this personal portfolio
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'status'])
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    match /projects/{projectId} {
      allow read: if true; // Public portfolio
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isAdmin() && isValidId(projectId);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['reviewerName', 'rating', 'projectName'])
        && data.reviewerName is string && data.reviewerName.size() <= 100
        && data.rating is number
        && data.projectName is string && data.projectName.size() <= 200;
    }
    
    match /reviews/{reviewId} {
      allow read: if true; // Public portfolio
      allow create: if isValidId(reviewId) && isValidReview(incoming()); // Anyone can add review
      allow update: if isAdmin() && isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    match /metadata/{docId} {
      // We'll just allow admins to write anything here for now to support different singleton docs
      allow read: if true;
      allow write: if isAdmin() && isValidId(docId);
    }
  }
}
